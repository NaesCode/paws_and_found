# --- Django ---
DEBUG=True
SECRET_KEY=replace-with-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,*

# --- Database: Supabase Postgres, always as the django_backend role ---
# CLOUD (shared project): Supabase dashboard > Connect > Session pooler
#   DB_HOST=aws-0-<region>.pooler.supabase.com   DB_PORT=5432
#   DB_USER=django_backend.<PROJECT_REF>         DB_SSLMODE=require
# LOCAL (supabase start): run `supabase status` to confirm the port
#   DB_HOST=host.docker.internal                 DB_PORT=54322
#   DB_USER=django_backend                       DB_SSLMODE=disable
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_USER=django_backend.<PROJECT_REF>
DB_PASSWORD=your_password_here
DB_NAME=postgres
DB_SSLMODE=require

# --- Supabase (Project Settings > API in the Supabase dashboard) ---
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here
SUPABASE_STORAGE_BUCKET=animal-photos

# --- AI & Matching Settings (Phase 4) ---
EMBEDDING_MODEL_VERSION=resnet18-in1k-v1+ssdlite-crop-v1
TORCH_THREADS=4
MAX_IMAGE_BYTES=10485760
AI_HORIZONTAL_FLIP_AVG=false
THROTTLE_AI_ANALYZE=10/minute
MATCH_BASE_SIMILARITY=0.78

# Ngrok tunnel (optional — for live physical device demo)
NGROK_URL=
