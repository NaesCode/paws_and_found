# Mobile App Environment Configuration Template
# Pass via Flutter CLI using --dart-define flags:
# flutter run --dart-define=GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com --dart-define=DJANGO_BASE_URL=http://localhost:8000

# Google OAuth Web Client ID (Public Identifier, NOT a secret)
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs (Web application)
GOOGLE_WEB_CLIENT_ID=467320972940-idmruqnpvd1fvuv1h7l24oqpvjcn56qb.apps.googleusercontent.com

# Google OAuth iOS Client ID (Public Identifier, NOT a secret)
# Required when building or running on an iOS device / iPhone
GOOGLE_IOS_CLIENT_ID=467320972940-c5ac1g2r9kpplk5ddtfhggs2eofvjnd7.apps.googleusercontent.com

# Django Orchestrator Base URL (Optional override)
# DJANGO_BASE_URL=http://10.0.2.2:8000
